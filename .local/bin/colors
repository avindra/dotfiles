#!/usr/bin/python3

# This script takes the colors generated by wallust
# and transfers the generated colors to pywal

import re
import sys
import json
from pathlib import Path

raw_text = ""
with open(Path.home() / ".cache/wallust/sequences", "r") as file:
    raw_text = file.read()

# Regex pattern to match OSC sequences setting palette colors 0 to 15
# Format matches: ]4;[0-15];#[HEX]
pattern = r"\]4;([0-9]|1[0-5]);(#[0-9A-Fa-f]{6})"

# Find all matches and store them in a dictionary mapping index -> hex code
matches = re.findall(pattern, raw_text)
color_dict = {int(index): hex_code for index, hex_code in matches}

# Gather the 16 colors in sequential order (0 to 15)
colors = []
for i in range(16):
    color = color_dict.get(i, "N/A")
    colors.append(color)

wal16= Path.home() / '.cache/wal/colors.json'
wal = {}
with open(wal16, 'r', encoding='utf-8') as file:
    wal = json.load(file)

for i in range(16):
    wal["colors"]["color" + str(i)] = colors[i]

wal["special"]["background"] = wal["colors"]["color0"]
wal["special"]["foreground"] = wal["colors"]["color1"]
wal["special"]["cursor"] = wal["colors"]["color7"]

color7 = wal["colors"]["color7"]
color13 = wal["colors"]["color13"]

wal["colors"]["color13"] = color7
wal["colors"]["color7"] = color13

color5 = wal["colors"]["color5"]
color14 = wal["colors"]["color14"]

wal["colors"]["color14"] = color5
wal["colors"]["color5"] = color14


if len(sys.argv) > 1:
    wal["wallpaper"] = sys.argv[1]

with open(wal16, "w") as file:
    json.dump(wal, file, indent=4)

