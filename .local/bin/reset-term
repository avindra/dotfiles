#!/usr/bin/sh

# Send reset signal to tty of the focused terminal
# see: https://gist.github.com/avindra/dd2c6f14ec6e03b05261d370ef60c9d8


if [ -n "$WAYLAND_DISPLAY" ]; then
	focus_pid=$(hyprctl activewindow |awk '/pid:/ {print $2}')
else
	focus_pid=$(xdotool getactivewindow getwindowpid)
fi

psInfo=$(ps o tty=,comm= --ppid "$focus_pid" | tail -1)

tty=$(echo "$psInfo" | cut -d" " -f1)
exe=$(echo "$psInfo" | cut -d" " -f6)

if [ "$exe" = "kitten" ]; then
	termPid=$(pgrep fish -P "$focus_pid")
	tty=$(readlink "/proc/${termPid}/fd/0")
else
	tty="/dev/pts/${tty:3}"
fi

printf "\033c" > "$tty"
