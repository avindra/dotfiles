#!/usr/bin/sh

# The latest version of flameshot has borked
# multi monitor support. For now, this script
# will automatically pick the active monitor.

monitor_id=$(hyprctl activewindow |awk '/monitor:/ {print $2}')

# https://github.com/flameshot-org/flameshot/issues/7#issuecomment-1988948398
export QT_SCALE_FACTOR=1

flameshot screen --number "${monitor_id}" --edit
