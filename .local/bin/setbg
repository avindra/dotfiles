#!/usr/bin/sh
# Apply the desired background image, and theme
# out the colors from it using a pallette
# generator, such as wal
#
# if the wallpaper is not being set, then this
# script will simply run the color effect again
#
set -euo pipefail

bgLink=~/.config/wallpaper
bg="${1:-}"

set_bg() {
	if [ -n "$WAYLAND_DISPLAY" ]]; then
		rwpspread --image "$1"  -b hyprpaper
	else
		# here be X11 dragons
		# reload isnt enough
		i3-msg restart
		feh --no-xinerama --bg-fill $1
	fi
}

set_colors() {
	wal -R

	# post-wal: restart dunst to apply new color
	systemctl --user restart dunst
}

selectedBg=$(cat ~/.cache/wal/colors.json | jq '.wallpaper')
linkedwp=$(readlink $bgLink)

if [ -n "$bg" ]; then
	selectedBg="$bg"
	ln -sf $bg $bgLink
	linkedwp="$bg"
else
	bg=$linkedwp
fi

if [ "$selectedBg" == '"None"' ]; then
	set_bg $linkedwp
	set_colors
else
	wallust pywal -a 95 -i "$linkedwp"  -n
	colors "$linkedwp"
	cat ~/.cache/wallust/sequences
	set_bg "$linkedwp"
	set_colors
fi

set_colors

