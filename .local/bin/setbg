#!/usr/bin/sh
# Apply the desired background image, and theme
# out the colors from it using a pallette
# generator, such as wal
#
# if the wallpaper is not being set, then this
# script will simply run the color effect again
#
set -euo pipefail

bgLink=~/.config/wallpaper
bg="${1:-}"

set_theme() {
	wal -R

	# post-wal: restart dunst to apply new color
	systemctl --user restart dunst
}

if [[ -n "$bg" ]]; then
	ln -sf $bg $bgLink
else
	bg=$bgLink
	theme_wp=$(cat ~/.cache/wal/colors.json | jq '.wallpaper')
	if [[ "$theme_wp" == '"None"' ]]; then
		set_theme
		exit 0
	fi
fi

real=$(readlink $bgLink)

if [[ -n "$WAYLAND_DISPLAY" ]]; then
	rwpspread --image "$real"  -b hyprpaper
else
	# here be X11 dragons
	# reload isnt enough
	i3-msg restart
	feh --no-xinerama --bg-fill $real
fi

# 1: generate colors with wallust
# 2: copy colors to pywal's json
# 3: use pywal to generate templates
# 4: reload colors in current terminal

wallust pywal -a 95 -i "$real"  -n
colors "$real"
cat ~/.cache/wallust/sequences
set_theme
