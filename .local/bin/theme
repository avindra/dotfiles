#!/usr/bin/sh

set -euo pipefail

themes=".local/lib/python3.13/site-packages/pywal/colorschemes/dark"

# shellcheck disable=SC2012
choice=$(ls "$themes" | rofi -dmenu -p "Choose a theme")

if [ -n "$choice" ]; then
	dunstify "Theme changed" "Theme set to: ${choice}"
	cp "$themes/$choice" ~/.cache/wal/colors.json
	wal -R
fi
